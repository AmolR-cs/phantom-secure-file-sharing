# Maximum upload file size in bytes (e.g. 50MB)
MAX_FILE_SIZE_BYTES=52428800

# Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storage path for encrypted chunks
STORAGE_DIR="./storage/blobs"
